    function stopSpectating()
        local runningThread = spectateFollowThread
        spectateFollowThread = nil
        spectateTarget = nil
        if runningThread then
            pcall(function() task.cancel(runningThread) end)
        end
        if spectateConnection then
            pcall(function() spectateConnection:Disconnect() end)
            spectateConnection = nil
        end

        -- Restore original camera state instead of guessing the CameraType.
        local camera = workspace.CurrentCamera
        if camera then
            local subject = spectateSavedCameraSubject
            if not subject or not subject.Parent then
                local currentChar = player.Character
                subject = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            end
            if subject then camera.CameraSubject = subject end
            if spectateSavedCameraType then
                camera.CameraType = spectateSavedCameraType
            end
        end

        local oldChar = spectateSavedCharacter
        local oldRoot = oldChar and oldChar:FindFirstChild("HumanoidRootPart")
        -- Only return the body we actually moved. Do not reposition a newly
        -- respawned character if the original one was destroyed.
        if oldRoot and oldRoot.Parent and spectateSavedCFrame then
            oldRoot.Anchored = false
            oldRoot.CFrame = spectateSavedCFrame
            oldRoot.AssemblyLinearVelocity = Vector3.zero
            oldRoot.AssemblyAngularVelocity = Vector3.zero
            oldRoot.Anchored = spectateSavedAnchored
        end
        if spectateSavedCollisions then
            for part, originallyCollidable in pairs(spectateSavedCollisions) do
                if part and part.Parent then
                    part.CanCollide = originallyCollidable
                end
            end
        end

        -- Re-sync the visible Spectate buttons when stopping via close, respawn,
        -- another UI toggle or switching players.
        for _, entry in pairs(AliveFeedRows or {}) do
            if entry.stopSpectate then
                pcall(entry.stopSpectate)
            end
        end
        spectateSavedCFrame = nil
        spectateSavedCollisions = nil
        spectateSavedCharacter = nil
        spectateSavedCameraSubject = nil
        spectateSavedCameraType = nil
    end

    function startSpectating(targetPlayer)
        if targetPlayer == player then
            ShowNotification("Spectate", "Select another player to spectate.", 3)
            return false
        end
        stopSpectating()
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local targetChar = targetPlayer.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local camera = workspace.CurrentCamera
        if not (myRoot and targetRoot and camera) then
            ShowNotification("Spectate", "Character or camera not loaded.", 3)
            return false
        end

        spectateSavedCFrame = myRoot.CFrame
        spectateSavedAnchored = myRoot.Anchored
        spectateSavedCharacter = myChar
        spectateSavedCameraSubject = camera.CameraSubject
        spectateSavedCameraType = camera.CameraType
        spectateSavedCollisions = {}
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                spectateSavedCollisions[part] = part.CanCollide
                part.CanCollide = false
            end
        end
        -- Don't anchor the body: anchoring can prevent ordinary character
        -- movement replication, which proximity voice may depend on.
        myRoot.Anchored = false
        local spectateDepth = getSpectateDepth(myChar)
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -spectateDepth, 0)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        spectateTarget = targetPlayer

        -- Spectate the other player's camera without touching Roblox's
        -- default voice chain. Creating an unwired AudioEmitter or disabling
        -- the original one does NOT make a remote player hear your microphone.
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = targetHum or targetRoot
        spectateConnection = trackConnection(targetPlayer.CharacterAdded:Connect(function(newChar)
            local newRoot = newChar:WaitForChild("HumanoidRootPart", 3)
            if newRoot and spectateTarget == targetPlayer then
                camera.CameraSubject = newChar:FindFirstChildOfClass("Humanoid") or newRoot
            end
        end))

        spectateFollowThread = trackThread(task.spawn(function()
            while spectateTarget == targetPlayer do
                local currentTargetChar = targetPlayer.Character
                local currentTargetRoot = currentTargetChar and currentTargetChar:FindFirstChild("HumanoidRootPart")
                local currentMyRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if targetPlayer.Parent ~= Players or not currentMyRoot or not currentMyRoot.Parent then
                    task.defer(stopSpectating)
                    break
                end
                if currentTargetRoot then
                    currentMyRoot.CFrame = currentTargetRoot.CFrame * CFrame.new(0, -spectateDepth, 0)
                    currentMyRoot.AssemblyLinearVelocity = Vector3.zero
                    currentMyRoot.AssemblyAngularVelocity = Vector3.zero
                    local currentHum = currentTargetChar:FindFirstChildOfClass("Humanoid")
                    if currentHum and camera.CameraSubject ~= currentHum then
                        camera.CameraSubject = currentHum
                    end
                end
                RunService.Heartbeat:Wait()
            end
        end))
        ShowNotification("Spectate", "Following " .. targetPlayer.Name .. " below the floor. VC depends on the server.", 5)
        return true
    end

