    function removeESP(character)
        local hl = espHighlights[character]
        if hl then
            pcall(function() hl:Destroy() end)
            espHighlights[character] = nil
        end
    end
    
    function addESP(character)
        if not espEnabled then return end
        if not character or not character.Parent then return end
        if character == player.Character then return end
        if espHighlights[character] then return end
        local hl = Instance.new("Highlight")
        hl.Name = "ApexESP_GreyOutline"
        hl.Adornee = character
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = ESP_FILL
        hl.FillTransparency = 1
        hl.OutlineColor = ESP_OUTLINE
        hl.OutlineTransparency = 0
        hl.Parent = ScreenGui
        espHighlights[character] = hl
        table.insert(espConnections, character.AncestryChanged:Connect(function(_, newParent)
            if not newParent then removeESP(character) end
        end))
    end
    
    function clearAllESP()
        local toRemove = {}
        for character in pairs(espHighlights) do table.insert(toRemove, character) end
        for _, character in ipairs(toRemove) do removeESP(character) end
        espHighlights = {}
        for _, conn in ipairs(espConnections) do pcall(function() conn:Disconnect() end) end
        espConnections = {}
    end
    
    function hookESPPlayer(p)
        if p == player then return end
        addESP(p.Character)
        table.insert(espConnections, p.CharacterAdded:Connect(function(char) task.wait(0.35) if espEnabled then addESP(char) end end))
        table.insert(espConnections, p.CharacterRemoving:Connect(function(char) removeESP(char) end))
    end
    
