    function teleportUnderBody(body, playerName)
        if autoRestoreSession then
            autoRestoreSession.active = false
            autoRestoreSession = nil
        end
        if not body or not body.Parent then return nil end
        local preTPCFrame = nil
        local success, err = pcall(function()
            local targetPart = body:FindFirstChild("HumanoidRootPart") or body.PrimaryPart or body:FindFirstChildWhichIsA("BasePart")
            local promptPart = nil
            for _, d in ipairs(body:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    promptPart = d.Parent
                    break
                end
            end
            local basePos = promptPart and promptPart.Position or (targetPart and targetPart.Position)
            if basePos then
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
