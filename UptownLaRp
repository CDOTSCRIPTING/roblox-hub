                blur.Name = "ApexAdminBlur"
                blur.Size = 20
                blur.Parent = workspace.CurrentCamera
                ShowNotification("Admin Cooldown", adminDisplay .. " put you on cooldown for " .. cooldownTime .. "s.", 5)
                task.wait(cooldownTime)
                if blur and blur.Parent then blur:Destroy() end
                Main.Visible = true
            end
        elseif punishType == "Freeze" then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp then hrp.Anchored = true end
            if hum then
                frozenPlayers = frozenPlayers or {}
                frozenPlayers[player.UserId] = {ws = hum.WalkSpeed, jp = hum.JumpPower}
                hum.WalkSpeed = 0; hum.JumpPower = 0
            end
            ShowNotification("Admin Punish", adminDisplay .. " froze you.", 4)
        elseif punishType == "Unfreeze" then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp then hrp.Anchored = false end
            if hum and frozenPlayers and frozenPlayers[player.UserId] then
                hum.WalkSpeed = frozenPlayers[player.UserId].ws
                hum.JumpPower = frozenPlayers[player.UserId].jp
                frozenPlayers[player.UserId] = nil
            elseif hum then
                hum.WalkSpeed = 16; hum.JumpPower = 50
            end
            ShowNotification("Admin Punish", adminDisplay .. " unfroze you.", 4)
        elseif punishType == "Kill" then
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
            ShowNotification("Admin Punish", adminDisplay .. " killed you.", 4)
        elseif punishType == "Heal" then
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = hum.MaxHealth end
            ShowNotification("Admin Punish", adminDisplay .. " healed you.", 4)
        elseif punishType == "Invisible" then
            local char = player.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.Transparency = 1 end
                end
            end
            ShowNotification("Admin Punish", adminDisplay .. " made you invisible.", 4)
        elseif punishType == "Visible" then
            local char = player.Character
