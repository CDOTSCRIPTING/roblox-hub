    function cleanUpFly()
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            if hrp then
                local bv = hrp:FindFirstChild("LootHunterFlyBV")
                local bg = hrp:FindFirstChild("LootHunterFlyGyro")
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
            end
            if humanoid then humanoid.PlatformStand = false end
        end
    end
    
    function toggleFly(state, btnRef)
        flyEnabled = state
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        if not hrp or not humanoid then return end
        if state then
            cleanUpFly()
            local flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "LootHunterFlyBV"
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = hrp
            local flyGyro = Instance.new("BodyGyro")
            flyGyro.Name = "LootHunterFlyGyro"
            flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            flyGyro.P = 1000
            flyGyro.D = 50
            flyGyro.Parent = hrp
            humanoid.PlatformStand = true
            trackThread(task.spawn(function()
                while flyEnabled and flyBV.Parent do
                    local cam = workspace.CurrentCamera
                    local dir = Vector3.zero
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end
                    if dir.Magnitude > 0 then dir = dir.Unit * flySpeed end
                    flyBV.Velocity = dir
                    flyGyro.CFrame = cam.CFrame
                    task.wait(0.01)
                end
                cleanUpFly()
            end))
        else
            cleanUpFly()
        end
    end
    
