        return false
    end
    local result, err = apexApiRequest("POST", "/send", {
        to = clientId, type = "PING"
    }, active.token)
    if not result then warn("[APEX MESSAGING] Send failed:", err) return false end
    print("[APEX MESSAGING] PING queued:", clientId)
    return true
end
