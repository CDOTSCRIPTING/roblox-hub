                addLog(newRole == "ADMIN" and "Promoted" or "Demoted", targetName)
                ShowNotification("APEX Roles", targetName .. " -> " .. newRole .. " (saved)", 5)
                refreshVerifiedApexPresence()
                refreshUserList()
