        -- Staff-gated client-side Bring request: receiver must run updated APEX,
        -- and be in the same Roblox server as EBKJAYALT.
        local function sendApexBringToClient(targetClientId, targetName, outputLabel)
            local active = apexMessagingSession
            if not active then
                if outputLabel then outputLabel.Text = "APEX messaging is disconnected." end
                ShowNotification("APEX Bring", "APEX messaging is disconnected.", 4)
                return
            end
            if not active.staff then
                if outputLabel then outputLabel.Text = "Owner/Staff permission required." end
                ShowNotification("APEX Bring", "Owner/Staff permission required.", 4)
                return
            end
            if targetClientId == active.id then
                if outputLabel then outputLabel.Text = "Cannot bring yourself." end
                return
            end
            if not Players:FindFirstChild(player.Name) then
                if outputLabel then outputLabel.Text = "Your player is not in this Roblox server." end
                return
            end
            task.spawn(function()
                local result, err = apexApiRequest("POST", "/send", {
                    to = targetClientId, type = "BRING"
                }, active.token)
                local status = result and ("Bring queued for " .. tostring(targetName) .. " -> " .. player.Name)
                    or ("Bring failed: " .. tostring(err))
                if outputLabel then outputLabel.Text = status end
                ShowNotification("APEX Bring", status, 4)
                if result then addLog("APEX Bring requested", tostring(targetName)) end
            end)
        end

