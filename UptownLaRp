                if not online then
                    ShowNotification("APEX Roles", "Unable to get online users: " .. tostring(err), 5)
                    return
                end
                local targetId
                for _, item in ipairs(online.clients or {}) do
                    if string.lower(tostring(item.name or "")) == string.lower(targetName) then
                        targetId = item.id
                        break
                    end
