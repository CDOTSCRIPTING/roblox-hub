    function getStatsFromUI()
        local food, water = 100, 100
        local candidates = {}
        pcall(function()
            for _, gui in ipairs(player.PlayerGui:GetDescendants()) do
                if gui:IsA("TextLabel") and gui.Visible then
                    if not gui:IsDescendantOf(ScreenGui) then
                        local text = gui.Text
                        if text and text ~= "" then
                            local valStr = string.match(text, "(%d+)%%")
                            if valStr then
                                local val = tonumber(valStr)
                                if val then
                                    table.insert(candidates, {value = val, x = gui.AbsolutePosition.X, y = gui.AbsolutePosition.Y})
                                end
                            end
                        end
                    end
                end
            end
        end)
        local viewportY = workspace.CurrentCamera.ViewportSize.Y
        local viewportX = workspace.CurrentCamera.ViewportSize.X
        local bottomElements = {}
        for _, c in ipairs(candidates) do
            if c.y > viewportY * 0.75 and c.x < viewportX * 0.6 then
                table.insert(bottomElements, c)
            end
        end
        table.sort(bottomElements, function(a, b) return a.x < b.x end)
        if #bottomElements >= 3 then food = bottomElements[3].value end
        if #bottomElements >= 4 then water = bottomElements[4].value end
        if type(food) ~= "number" then food = 100 end
        if type(water) ~= "number" then water = 100 end
        return food, water
    end
    
