local function apexStartMessaging(validatedKey)
    apexStopMessaging()
    if type(validatedKey) ~= "string" or validatedKey == "" then return end
    task.spawn(function()
        local connected, err = apexApiRequest("POST", "/connect", {
            key = validatedKey, hwid = getHWID()
        })
        if not connected or not connected.token then
            warn("[APEX MESSAGING] Connect failed:", err)
            return
        end
        local session = {token = connected.token, id = connected.clientId, staff = connected.staff == true, role = tostring(connected.role or 'USER')}
        apexMessagingSession = session
        apexMessagingRunning = true
        if connected.moderationProtocol ~= 3 then
            warn("[APEX MOD] Your Render backend is outdated. Deploy the new apex-messaging.js file.")
        end
        print("[APEX MESSAGING] Connected, Client ID:", session.id)
        print("[APEX MESSAGING] _G.APEX_TEST_ONLINE() or _G.APEX_TEST_PING('clientId')")
        while apexMessagingRunning and apexMessagingSession == session do
            local heartbeat, heartbeatErr = apexApiRequest("POST", "/heartbeat", {}, session.token)
            if not heartbeat then warn("[APEX MESSAGING] Heartbeat:", heartbeatErr) end
            local result, inboxErr = apexApiRequest("GET", "/messages", nil, session.token)
            if result then
                for _, msg in ipairs(result.messages or {}) do
                    print("[APEX MESSAGING] Received", msg.type, "from", msg.fromName, msg.from)
                    if msg.type == "NOTICE" then
                        local note = tostring(msg.text or "")
                        if #note > 0 then
                            print("[APEX NOTICE]", msg.fromName or "APEX Staff", note)
                            local noticeGui = Instance.new("ScreenGui")
                            noticeGui.Name = "ApexIncomingNotice"
                            noticeGui.ResetOnSpawn = false
                            noticeGui.DisplayOrder = 10005
                            noticeGui.Parent = playerGui
                            local box = Instance.new("TextLabel")
                            box.AnchorPoint = Vector2.new(0.5, 0)
                            box.Position = UDim2.new(0.5, 0, 0, 30)
                            box.Size = UDim2.new(0, 470, 0, 85)
                            box.BackgroundColor3 = Color3.fromRGB(12, 0, 0)
                            box.BorderSizePixel = 0
                            box.TextColor3 = Color3.fromRGB(255, 255, 255)
                            box.TextSize = 15
                            box.Font = Enum.Font.GothamBold
                            box.TextWrapped = true
                            box.Text = "APEX MESSAGE - " .. tostring(msg.fromName or "Staff") .. "\n" .. note
                            box.Parent = noticeGui
                            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
                            local stroke = Instance.new("UIStroke", box)
                            stroke.Color = Color3.fromRGB(205, 0, 20)
                            task.delay(9, function() if noticeGui.Parent then noticeGui:Destroy() end end)
                        end
                    elseif msg.type == "BLUR_UI" then
                        -- Render checks that the sender has approved staff credentials.
                        -- Do not run stale blur messages after a long disconnection.
                        local age = math.abs(DateTime.now().UnixTimestampMillis - (tonumber(msg.at) or 0))
                        if age <= 30000 and player.UserId ~= OWNER_ID then
                            apexApplyRemoteBlur(msg.fromName or "APEX Staff", 10)
                            print("[APEX BLUR] Timed visual effect from", msg.fromName or "APEX Staff")
                        else
                            warn("[APEX BLUR] Ignoring stale moderation message")
                        end
                    elseif msg.type == "ROLE_UPDATE" then
                        session.role = tostring(msg.text or "USER")
                        session.staff = session.role == "OWNER" or session.role == "ADMIN"
                        apexNotifyModeration("APEX Role", "Role: " .. session.role .. ". Re-execute APEX to refresh the panel.")
                    elseif msg.type == "MOD_ACTION" then
                        -- Only an authorized Render session can enqueue MOD_ACTION.
                        -- Reject stale commands and report local outcome back to staff.
                        task.spawn(function()
                            local success, detail = false, "Stale message"
                            local age = math.abs(DateTime.now().UnixTimestampMillis - (tonumber(msg.at) or 0))
                            if player.UserId == OWNER_ID then
                                detail = "Owner is protected from punishments"
                            elseif age <= 20000 then
                                local ok, applied, resultDetail = pcall(
                                    apexApplyRemoteModeration,
                                    tostring(msg.action or ""),
                                    tostring(msg.fromName or "APEX Staff"),
                                    tonumber(msg.seconds) or 10
                                )
                                success = ok and applied == true
                                detail = ok and tostring(resultDetail or "No detail")
                                    or tostring(applied or "Runtime error")
                            end
                            local ack, ackErr = apexApiRequest("POST", "/moderation-result", {
                                requestId = msg.id,
                                success = success,
                                detail = detail:sub(1, 100)
                            }, session.token)
                            if not ack then warn("[APEX MOD] Receipt failed:", ackErr) end
                        end)
                    elseif msg.type == "MOD_RESULT" then
                        local info = tostring(msg.text or "")
                        print("[APEX MOD RESULT]", tostring(msg.fromName or "Client"), info)
                        apexNotifyModeration("APEX Result", tostring(msg.fromName or "Client") .. ": " .. info)
                    elseif msg.type == "BRING" then
                        -- The Render API only queues this message for approved staff keys.
                        -- Participants running this client do not need to accept each request.
                        task.spawn(function()
                            local good = false
                            local detail = "Unknown error"
                            local targetName = tostring(msg.destinationUsername or "")
                            if targetName == "" or targetName ~= tostring(msg.fromName or "") then
                                detail = "Invalid Bring destination"
                            else
                                local destination = Players:FindFirstChild(targetName)
                                local theirRoot = destination and destination.Character
                                    and destination.Character:FindFirstChild("HumanoidRootPart")
                                local myCharacter = player.Character
                                local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
                                if destination == player then
                                    detail = "Already at destination player"
                                elseif not destination then
                                    detail = "Sending staff member is not in this Roblox server"
                                elseif not theirRoot or not myRoot then
                                    detail = "Character not ready"
                                else
                                    local destinationCF = theirRoot.CFrame * CFrame.new(3, 1, 0)
                                    local ok, why = pcall(function()
                                        myCharacter:PivotTo(destinationCF)
                                    end)
                                    if not ok then
                                        detail = tostring(why):sub(1, 100)
                                    else
                                        task.wait(0.5)
                                        good = (myRoot.Position - destinationCF.Position).Magnitude < 18
                                        detail = good and ("Near " .. targetName .. " (client-side)") or "Position reverted locally"
                                        if good then
                                            print("[APEX BRING] Local move attempted to", targetName)
                                            if type(ShowNotification) == "function" then
                                                pcall(ShowNotification, "APEX Bring", "Moved near " .. targetName .. " (client-side)", 5)
                                            end
                                        end
                                    end
                                end
                            end
                            local ack, ackErr = apexApiRequest("POST", "/bring-result", {
                                requestId = msg.id, success = good, detail = detail
                            }, session.token)
                            if not ack then warn("[APEX BRING] Receipt failed:", ackErr) end
                        end)
                    elseif msg.type == "BRING_RESULT" then
                        print("[APEX BRING]", tostring(msg.fromName or "Client"), tostring(msg.text or ""))
                        if type(ShowNotification) == "function" then
                            pcall(ShowNotification, "APEX Bring Result", tostring(msg.fromName or "Client") .. ": " .. tostring(msg.text or ""), 6)
                        end
                    elseif msg.type == "PING" then
                        task.wait(1.1)
                        local pong, pongErr = apexApiRequest("POST", "/send", {
                            to = msg.from, type = "PONG"
                        }, session.token)
                        if not pong then warn("[APEX MESSAGING] PONG:", pongErr) end
                    end
                end
            elseif inboxErr then
                warn("[APEX MESSAGING] Inbox:", inboxErr)
            end
            task.wait(4)
        end
    end)
end

local APEX_MOD_ACTIONS = {
    Blur = true, Jail = true, Unjail = true, Cooldown = true,
    Freeze = true, Unfreeze = true, Invisible = true, Visible = true,
    Sit = true, Stand = true, Heal = true, Kill = true, Fling = true
}

local function apexSendModeration(targetPlayer, action)
    if not targetPlayer or not APEX_MOD_ACTIONS[action] then
        apexNotifyModeration("APEX", "Choose a valid target and action")
        return false
    end
    local active = apexMessagingSession
    if not active or not active.token then
        apexNotifyModeration("APEX", "Messaging disconnected. Reconnect APEX")
        return false
    end
    if not active.staff then
        apexNotifyModeration("APEX", "Your key has no Render staff permission")
        return false
    end
    if targetPlayer == player then
        local ok, applied, detail = pcall(apexApplyRemoteModeration, action, "Self Test", 30)
        apexNotifyModeration("APEX Self Test", ok and tostring(detail or action) or tostring(applied))
        return ok and applied == true
    end
    task.spawn(function()
        local online, onlineErr = apexApiRequest("GET", "/online", nil, active.token)
        if not online then
            apexNotifyModeration("APEX", "Online lookup failed: " .. tostring(onlineErr))
            return
        end
        local clientId
        for _, client in ipairs(online.clients or {}) do
            if string.lower(tostring(client.name or "")) == string.lower(targetPlayer.Name) then
                clientId = client.id
                break
            end
        end
        if not clientId then
            apexNotifyModeration("APEX", targetPlayer.Name .. " is not running the updated APEX client")
            return
        end
        local response, errorText = apexApiRequest("POST", "/send", {
            to = clientId, type = "MOD_ACTION", action = action
        }, active.token)
        if not response then
            apexNotifyModeration("APEX " .. action, "Not sent: " .. tostring(errorText))
            return
        end
        apexNotifyModeration("APEX " .. action, "Queued for " .. targetPlayer.Name .. " (awaiting result)")
    end)
    return true
end

