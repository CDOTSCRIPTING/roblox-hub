function getHWID()
    return game:GetService("RbxAnalyticsService"):GetClientId()
end

function validateKey(key)
    local hwid = getHWID()
    local payload = HttpService:JSONEncode({key = key, hwid = hwid, username = player.Name})
    local req = syn and syn.request or http_request or request or (http and http.request) or fluxus and fluxus.request
    if not req then return false, "Executor missing HTTP request function" end
    local success, response = pcall(function()
        return req({
            Url = API_ENDPOINT,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
    if success and response then
        if response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            if data.valid then return true, data.type else return false, data.error or "Invalid key" end
        elseif response.StatusCode == 502 or response.StatusCode == 503 then
            return false, "Server waking up. Wait 10s and try again."
        else
            return false, "Server error (HTTP " .. tostring(response.StatusCode) .. ")"
        end
    end
    return false, "Network error. Check console (F9) or wait for server."
end

