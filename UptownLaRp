    local function isApexNavigationButton(button)
        local name = button.Name or ""
        local label = button:IsA("TextButton") and button.Text or ""
        label = tostring(label):gsub("^%s+", ""):gsub("%s+$", "")
        if name:find("SidebarBtn", 1, true)
            or name:find("QuickAction", 1, true)
            or name == "ApexUserRow" or name == "ApexClientRow"
            or name == "CloseButton" or name == "MinimizeButton" then
            return true
        end
        -- Only exclude named main tabs, not similarly-named action buttons.
        if label == "Teleports" or label == "Farm" or label == "Misc" then
            return true
        end
        if label == "×" or label == "—" or label == "−" or label == "+"
            or label == "▼ BACKPACK" or label == "▲ HIDE" then
            return true
        end
        if label == "REFRESH USERS" or label == "REFRESH" then
            return true
        end
        return false
    end

    local function bindApexButtonFeedback(button)
        if not (button:IsA("TextButton") or button:IsA("ImageButton")) then return end
        if apexFeedbackBound[button] then return end
        apexFeedbackBound[button] = true

        trackConnection(button.MouseButton1Click:Connect(function()
            if isApexNavigationButton(button) then return end
            local countBefore = apexFeedbackMessageCount
            playApexFeedbackSound()
            task.delay(0.18, function()
                if not ScreenGui.Parent or not button.Parent then return end
                if apexFeedbackMessageCount ~= countBefore then return end
                local featureName = button:GetAttribute("ApexFeatureName")
                if button:GetAttribute("ApexFeatureToggle") and featureName then
                    local enabled = button:GetAttribute("ApexFeatureEnabled")
                    ShowNotification("APEX", featureName .. (enabled and " enabled" or " disabled"), 1.8)
                    return
                end
                local label = button:IsA("TextButton") and button.Text or ""
                label = tostring(label):gsub("%s+", " "):match("^%s*(.-)%s*$")
                if label == "" or label == "TextButton" or label == "ImageButton" then
                    return -- unlabeled UI element, not a known action
                end
                if #label > 48 then label = label:sub(1, 45) .. "..." end
                ShowNotification("APEX", label, 1.8)
            end)
        end))
    end

