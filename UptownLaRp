    -- Preserve the character's real appearance and collisions before hiding it
    -- beneath a dead player. HumanoidRootPart is normally invisible: making all
    -- parts Transparency=0 during restore creates the white box around the avatar.
    local deadRadarSavedAppearance = nil

    function restoreToLastPosition(overrideCFrame)
        if autoRestoreSession then
            autoRestoreSession.active = false
            autoRestoreSession = nil
        end
        if getgenv().DeadTPConnection then
            getgenv().DeadTPConnection:Disconnect()
            getgenv().DeadTPConnection = nil
        end
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("SelectionBox") or part:IsA("Highlight") or part:IsA("BoxHandleAdornment") then
                    part:Destroy()
                end
            end
        end
        local restoreCF = overrideCFrame or SAFE_RESTORE_CFRAME
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local restored = false
        if hrp and restoreCF then
            hrp.Anchored = false
            -- The RESTORE POSITION button passes SAFE_RESTORE_CFRAME explicitly.
            -- Auto-restore can still pass its original pre-TP position.
            char:PivotTo(restoreCF)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            if deadRadarSavedAppearance and deadRadarSavedAppearance.character == char then
                for part, original in pairs(deadRadarSavedAppearance.parts) do
                    if part and part.Parent then
                        part.Transparency = original.transparency
                        part.CanCollide = original.canCollide
                    end
                end
            else
                -- Fallback for a previously hidden character without a snapshot.
                -- Never make the normally invisible root part opaque.
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= hrp and part.Transparency >= 1 then
                        part.Transparency = 0
                    end
                end
            end
            deadRadarSavedAppearance = nil
            hrp.Transparency = 1
            hrp.CanCollide = false

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local camera = workspace.CurrentCamera
            if humanoid and camera then
                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = humanoid
            end
            restored = true
        end
        for i = #modifiedPrompts, 1, -1 do
            local prompt = modifiedPrompts[i]
            if prompt and prompt.Parent then
                pcall(function()
                    prompt.MaxActivationDistance = 10
                    prompt.RequiresLineOfSight = true
                end)
            end
            modifiedPrompts[i] = nil
        end
        return restored
    end

