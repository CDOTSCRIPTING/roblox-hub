    -- Private local self-test handler. No other player's request can reach this
    -- code for the owner's character: the network listener below rejects it.
    local function applyApexPunishmentLocally(punishType, adminName)
        local cooldownTime = getgenv().ApexCooldownTime or 30
        local adminDisplay = adminName or "An Admin"
        if punishType == "Blur" then
            local blur = Instance.new("BlurEffect")
            blur.Name = "ApexAdminBlur"
            blur.Size = 20
            blur.Parent = workspace.CurrentCamera
            ShowNotification("Admin Punish", adminDisplay .. " blurred you for " .. cooldownTime .. "s.", 4)
            task.wait(cooldownTime)
            if blur and blur.Parent then blur:Destroy() end
        elseif punishType == "Cooldown" then
            if Main then
                Main.Visible = false
