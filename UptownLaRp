    -- Dead Player Radar loot alert thresholds (case-insensitive, substring matches).
    -- More specific names come first; BOD is deliberately a keyword so it
    -- detects all variants such as "BOD Pack" and "BOD ... Pack".
    local apexLootAlertRules = {
        {keyword = "chain",             minimum = 1,   title = "CHAIN ALERT"},
        {keyword = "r15",               minimum = 100, title = "R15 ALERT"},
        {keyword = "lucky charmz",      minimum = 100, title = "LUCKY CHARMZ ALERT"},
        {keyword = "berry lemon fizz pro", minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "berry lemon fizz",  minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "killsquad pack",    minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "grape rush",        minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "kool-aid",          minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "uptown slabs",      minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "76 pack",           minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "rdg pack",          minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "eclipse pack",      minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "pshyco runtz",      minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "ebk pack",          minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "bod",               minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "mc",                minimum = 200, title = "HIGH VALUE TARGET"},
        {keyword = "cdg",               minimum = 200, title = "HIGH VALUE TARGET"},
    }

    local function apexLootRuleForName(itemName)
        local lowered = string.lower(tostring(itemName or ""))
        for _, rule in ipairs(apexLootAlertRules) do
            -- Plain keyword search avoids treating punctuation as Lua patterns.
            if string.find(lowered, rule.keyword, 1, true) then
                return rule
            end
        end
        return nil
    end

    local function apexCollectLootAlerts(items)
        -- Combine counts for variants of the same keyword (especially BOD).
        local totals = {}
        for itemName, amount in pairs(items) do
            local rule = apexLootRuleForName(itemName)
            local count = math.max(0, tonumber(amount) or 0)
            if rule and count > 0 then
                local slot = totals[rule.keyword]
                if not slot then
                    slot = {count = 0, firstName = itemName, variantCount = 0}
                    totals[rule.keyword] = slot
                end
                slot.count = slot.count + count
                slot.variantCount = slot.variantCount + 1
            end
        end
        local alerts = {}
        for _, rule in ipairs(apexLootAlertRules) do
            local slot = totals[rule.keyword]
            if slot and slot.count >= rule.minimum then
                table.insert(alerts, {
                    key = rule.keyword,
                    title = rule.title,
                    count = slot.count,
                    displayName = slot.variantCount > 1
                        and (string.upper(rule.keyword) .. " items") or slot.firstName,
                })
            end
        end
        return alerts
    end

    function getCategoryColor(itemName)
        local low = string.lower(itemName)
        if low:find("arp") or low:find("gun") or low:find("ak") or low:find("vector") or low:find("pistol") or low:find("shotgun") or low:find("rifle") or low:find("smg") then return theme.gun, "WEAPON"
        elseif low:find("ammo") or low:find("round") or low:find("mag") or low:find("bullet") then return theme.ammo, "AMMO"
        elseif low:find("burger") or low:find("food") or low:find("pizza") or low:find("sandwich") or low:find("meal") then return theme.food, "FOOD"
        elseif low:find("drink") or low:find("water") or low:find("soda") or low:find("juice") or low:find("cola") then return theme.water, "DRINK"
        elseif low:find("card") then return theme.gold, "CARD"
        elseif low:find("slab") or low:find("grape") or low:find("drug") or low:find("freeze") or low:find("essence") or low:find("booster") or low:find("weed") or low:find("coke") or low:find("cdg") then return theme.accent, "DRUG" end
        return theme.subtext, "ITEM"
    end
    
