local function apexApiRequest(method, path, payload, token)
    local requestFn = (syn and syn.request) or http_request or request
        or (http and http.request) or (fluxus and fluxus.request)
    if type(requestFn) ~= "function" then
        return nil, "Missing HTTP request function"
    end
    local headers = {["Content-Type"] = "application/json"}
    if token then headers.Authorization = "Bearer " .. token end
    local requestData = {Url = APEX_MESSAGING_URL .. path,
        Method = method, Headers = headers}
    if payload ~= nil then requestData.Body = HttpService:JSONEncode(payload) end
    local ok, response = pcall(requestFn, requestData)
    if not ok or not response then return nil, "Network error: " .. tostring(response) end
    local decodedOk, parsed = pcall(function()
        return HttpService:JSONDecode(response.Body or "{}")
    end)
    if not decodedOk or type(parsed) ~= "table" then return nil, "Invalid API response" end
    local code = tonumber(response.StatusCode or response.Status or 0)
    if code < 200 or code >= 300 then
        return nil, tostring(parsed.error or ("HTTP " .. code)), code
    end
    return parsed
end

