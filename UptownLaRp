    function getPromptWorldPosition(prompt)
        local parent = prompt.Parent
        if not parent then return nil end
        if parent:IsA("Attachment") then return parent.WorldPosition
        elseif parent:IsA("BasePart") then return parent.Position
        elseif parent:IsA("Model") then return parent:GetPivot().Position end
        return nil
    end
    
    function findNearestPrompt(maxDistance)
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local nearest, nearestDistance = nil, maxDistance
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local position = getPromptWorldPosition(obj)
                if position then
                    local distance = (position - hrp.Position).Magnitude
                    if distance <= math.min(maxDistance, obj.MaxActivationDistance + 2) and distance < nearestDistance then
                        nearest, nearestDistance = obj, distance
                    end
                end
            end
        end
        return nearest
    end
    
    function teleportToInteractionPoint(cframe, displayName)
        safeTeleport(cframe, false)
        task.wait(0.25)
        local prompt = findNearestPrompt(15)
        if not prompt then
            ShowNotification("Prompt not found", "No enabled ProximityPrompt was found nearby. You can activate it manually.", 4)
            return
        end
        ShowNotification("Interacting", "Holding the nearby prompt for 3 seconds...", 3)
        local started = pcall(function() prompt:InputHoldBegin() end)
        if not started then
            ShowNotification("Interaction failed", "The prompt could not be started.", 4)
            return
        end
        task.wait(3)
        pcall(function() prompt:InputHoldEnd() end)
        task.wait(0.35)
        safeTeleport(SAFE_RESTORE_CFRAME, false)
        ShowNotification("Returned", displayName .. " interaction finished. Returned to safe location.", 4)
    end
    
