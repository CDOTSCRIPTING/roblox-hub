    local lastDealerHit = nil
    
    local function getDealerChestPart(dealer)
        if not dealer then return nil end
        local candidates = {"UpperTorso", "Torso", "Chest", "HumanoidRootPart"}
        for _, name in ipairs(candidates) do
            local p = dealer:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p end
        end
        if dealer.PrimaryPart and dealer.PrimaryPart:IsA("BasePart") then return dealer.PrimaryPart end
        for _, d in ipairs(dealer:GetDescendants()) do
            if d:IsA("BasePart") then return d end
        end
        return nil
    end

    local function findClosestDealer(myHrp)
        local bestDealer, bestPart, bestDist = nil, nil, math.huge
        local function check(obj)
            if obj:IsA("Model") and obj.Name == "DealerClient" then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local alive = (not hum) or hum.Health > 0
                local part = getDealerChestPart(obj)
                if part and alive then
                    local d = (part.Position - myHrp.Position).Magnitude
                    if d < bestDist and d <= 65 then
                        bestDist = d
                        bestDealer = obj
                        bestPart = part
                    end
                end
            end
        end
        for _, child in ipairs(workspace:GetChildren()) do
            check(child)
            for _, sub in ipairs(child:GetChildren()) do
                check(sub)
            end
        end
        return bestDealer, bestPart, bestDist
    end

    CreateModernToggle(MiscPage, "Auto TP Inside Dealer (Tap E to Sell)", 326, function(state)
        dealerAutoEnabled = state
        instantPromptsEnabled = state

        if state then
            if not promptConnection then
                promptConnection = trackConnection(ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
                    if instantPromptsEnabled and prompt then
                        if prompt.HoldDuration > 0 then prompt.HoldDuration = 0 end
                        if prompt.Style ~= Enum.ProximityPromptStyle.Default then prompt.Style = Enum.ProximityPromptStyle.Default end
                    end
                end))
            end

            if dealerThread then pcall(function() task.cancel(dealerThread) end) dealerThread = nil end
            dealerThread = trackThread(task.spawn(function()
                while dealerAutoEnabled and ScreenGui.Parent do
                    local myChar = player.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

                    if myHrp then
                        local dealer, dealerPart = findClosestDealer(myHrp)

                        if dealer and dealerPart and dealer ~= lastDealerHit then
                            lastDealerHit = dealer
                            
                            -- Disable collision so you sink in
                            for _, part in ipairs(myChar:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end

                            -- Teleport to the chest first so you are inside
                            myHrp.CFrame = dealerPart.CFrame
                            
                            -- Use BodyPosition to FORCE us to stay inside the chest without laggy loops
                            local bp = myHrp:FindFirstChild("ApexDealerBP") or Instance.new("BodyPosition")
                            bp.Name = "ApexDealerBP"
                            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bp.P = 10000
                            bp.D = 500
                            bp.Position = dealerPart.Position
                            bp.Parent = myHrp
                            
                            -- BodyGyro keeps us upright and stops spinning
                            local bg = myHrp:FindFirstChild("ApexDealerBG") or Instance.new("BodyGyro")
                            bg.Name = "ApexDealerBG"
                            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                            bg.P = 10000
                            bg.D = 500
                            bg.CFrame = dealerPart.CFrame
                            bg.Parent = myHrp

                            ShowNotification("Auto Dealer", "TP'd inside dealer — tap E to sell.", 3)
                        end

                        -- Clean up markers if dealer despawns or goes out of range
                        if lastDealerHit then
                            if not lastDealerHit.Parent then
                                lastDealerHit = nil
                                if myHrp then
                                    local bp = myHrp:FindFirstChild("ApexDealerBP")
                                    local bg = myHrp:FindFirstChild("ApexDealerBG")
                                    if bp then bp:Destroy() end
                                    if bg then bg:Destroy() end
                                end
                            elseif dealerPart and (dealerPart.Position - myHrp.Position).Magnitude > 10 then
                                -- If we get pushed out too far, re-snap
                                if myHrp then
                                    local bp = myHrp:FindFirstChild("ApexDealerBP")
                                    if bp then bp.Position = dealerPart.Position end
                                end
                            end
                        end
                    end

                    task.wait(0.5)
                end
            end))
        else
            if dealerThread then pcall(function() task.cancel(dealerThread) end) dealerThread = nil end
            if promptConnection then promptConnection:Disconnect() promptConnection = nil end
            lastDealerHit = nil
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bp = hrp:FindFirstChild("ApexDealerBP")
                    local bg = hrp:FindFirstChild("ApexDealerBG")
                    if bp then bp:Destroy() end
                    if bg then bg:Destroy() end
                end
            end
        end
    end)
    
