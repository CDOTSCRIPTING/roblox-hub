-- APEX Render moderation effects are local to the client that installed APEX.
-- None of these effects grants control over Roblox's authoritative server.
local apexLocalJail = nil
local apexFreezeState = nil
local apexInvisibleParts = nil
local apexCooldownGeneration = 0

local function apexNotifyModeration(title, detail)
    if type(ShowNotification) == "function" then
        pcall(ShowNotification, title, detail, 4)
    else
        print("[APEX MOD]", title, detail)
    end
end

local function apexReleaseJail()
    local current = apexLocalJail
    apexLocalJail = nil
    if not current then return false end
    if current.model and current.model.Parent then current.model:Destroy() end
    local sameChar = player.Character == current.character
    local root = sameChar and current.character:FindFirstChild("HumanoidRootPart")
    local hum = sameChar and current.character:FindFirstChildOfClass("Humanoid")
    if root then
        root.Anchored = current.anchored
        if current.start and not current.anchored then
            pcall(function() current.character:PivotTo(current.start) end)
        end
    end
    if hum then
        hum.WalkSpeed = current.walkSpeed
        hum.JumpPower = current.jumpPower
        hum.AutoRotate = current.autoRotate
    end
    return true
end

local function apexReleaseFreeze()
    local current = apexFreezeState
    apexFreezeState = nil
    if not current or player.Character ~= current.character then return false end
    local root = current.character:FindFirstChild("HumanoidRootPart")
    local hum = current.character:FindFirstChildOfClass("Humanoid")
    if root then root.Anchored = current.anchored end
    if hum then
        hum.WalkSpeed = current.walkSpeed
        hum.JumpPower = current.jumpPower
        hum.AutoRotate = current.autoRotate
    end
    return true
end

local function apexApplyRemoteModeration(action, staffName, seconds)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local duration = math.clamp(tonumber(seconds) or 10, 1, 30)
    if action == "Blur" then
        apexApplyRemoteBlur(staffName, math.min(duration, 10))
        apexNotifyModeration("APEX", "Screen effect from " .. staffName)
        return true, "10-second screen and UI effect"
    elseif action == "Jail" then
        if not root or not hum then return false, "Character not ready" end
        apexReleaseJail()
        -- Local-only visible cell. It cannot enforce jail against Roblox server physics.
        local state = {
            character = character, start = root.CFrame, anchored = root.Anchored,
            walkSpeed = hum.WalkSpeed, jumpPower = hum.JumpPower,
            autoRotate = hum.AutoRotate
        }
        local model = Instance.new("Model")
        model.Name = "APEX_LocalJail"
        model.Parent = workspace
        state.model = model
        local center = root.Position
        local pieces = {
            {"Floor", Vector3.new(9, 0.8, 9), Vector3.new(0, -3, 0)},
            {"Roof", Vector3.new(9, 0.8, 9), Vector3.new(0, 6, 0)},
            {"Left", Vector3.new(0.6, 9, 9), Vector3.new(-4.2, 1.5, 0)},
            {"Right", Vector3.new(0.6, 9, 9), Vector3.new(4.2, 1.5, 0)},
            {"Front", Vector3.new(9, 9, 0.6), Vector3.new(0, 1.5, -4.2)},
            {"Back", Vector3.new(9, 9, 0.6), Vector3.new(0, 1.5, 4.2)}
        }
        for _, descriptor in ipairs(pieces) do
            local part = Instance.new("Part")
            part.Name = "APEX_" .. descriptor[1]
            part.Anchored = true
            part.Size = descriptor[2]
            part.Position = center + descriptor[3]
            part.CanCollide = true
            part.Material = Enum.Material.Metal
            part.Color = Color3.fromRGB(45, 45, 48)
            part.Transparency = 0.2
            part.Parent = model
        end
        root.Anchored = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
        apexLocalJail = state
        task.delay(math.min(duration, 30), function()
            if apexLocalJail == state then
                apexReleaseJail()
                apexNotifyModeration("APEX", "Local jail timed out")
            end
        end)
        apexNotifyModeration("APEX Jail", "Temporary local jail (30 seconds maximum)")
        return true, "Temporary client-side cage created"
    elseif action == "Unjail" then
        local released = apexReleaseJail()
        apexNotifyModeration("APEX Unjail", released and "Local jail cleared" or "No local jail active")
        return true, released and "Released" or "No active jail"
    elseif action == "Cooldown" then
        apexCooldownGeneration = apexCooldownGeneration + 1
        local generation = apexCooldownGeneration
        local old = playerGui:FindFirstChild("APEX_LocalCooldown")
        if old then old:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "APEX_LocalCooldown"
        gui.DisplayOrder = 10021
        gui.IgnoreGuiInset = true
        gui.ResetOnSpawn = false
        gui.Parent = playerGui
        local cover = Instance.new("Frame")
        cover.Size = UDim2.fromScale(1, 1)
        cover.BackgroundColor3 = Color3.fromRGB(7, 5, 7)
        cover.BackgroundTransparency = 0.08
        cover.Active = true
        cover.Parent = gui
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(0.75, 0, 0, 125)
        txt.AnchorPoint = Vector2.new(0.5, 0.5)
        txt.Position = UDim2.fromScale(0.5, 0.5)
        txt.TextColor3 = Color3.fromRGB(255, 60, 60)
        txt.BackgroundTransparency = 1
        txt.Font = Enum.Font.GothamBold
        txt.TextScaled = true
        txt.TextWrapped = true
        txt.Text = "APEX COOLDOWN\nYour APEX interface is temporarily unavailable"
        txt.Parent = cover
        task.delay(math.min(duration, 30), function()
            if apexCooldownGeneration == generation and gui.Parent then gui:Destroy() end
        end)
        return true, "Temporary client-side cooldown shown"
    elseif action == "Freeze" then
        if not root or not hum then return false, "Character not ready" end
        apexReleaseFreeze()
        local state = {character = character, anchored = root.Anchored,
            walkSpeed = hum.WalkSpeed, jumpPower = hum.JumpPower,
            autoRotate = hum.AutoRotate}
        apexFreezeState = state
        root.Anchored = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
        task.delay(math.min(duration, 30), function()
            if apexFreezeState == state then apexReleaseFreeze() end
        end)
        return true, "Temporary local freeze"
    elseif action == "Unfreeze" then
        apexReleaseFreeze()
        return true, "Local freeze cleared"
    elseif action == "Invisible" then
        if not character then return false, "Character not ready" end
        if apexInvisibleParts then
            for part, old in pairs(apexInvisibleParts) do
                if part.Parent then part.LocalTransparencyModifier = old end
            end
        end
        local original = {}
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                original[part] = part.LocalTransparencyModifier
                part.LocalTransparencyModifier = 1
            end
        end
        apexInvisibleParts = original
        task.delay(math.min(duration, 30), function()
            if apexInvisibleParts == original then
                for part, old in pairs(original) do
                    if part.Parent then part.LocalTransparencyModifier = old end
                end
                apexInvisibleParts = nil
            end
        end)
        return true, "Temporary local invisibility"
    elseif action == "Visible" then
        for part, old in pairs(apexInvisibleParts or {}) do
            if part.Parent then part.LocalTransparencyModifier = old end
        end
        apexInvisibleParts = nil
        return true, "Local appearance restored"
    elseif action == "Sit" or action == "Stand" then
        if not hum then return false, "Character not ready" end
        hum.Sit = (action == "Sit")
        return true, "Local sit state updated"
    elseif action == "Heal" or action == "Kill" then
        if not hum then return false, "Character not ready" end
        hum.Health = action == "Heal" and hum.MaxHealth or 0
        return true, "Local health change attempted (server may override)"
    elseif action == "Fling" then
        if not root then return false, "Character not ready" end
        root.AssemblyLinearVelocity = Vector3.new(0, 65, 0)
        return true, "Local upward impulse attempted (server may override)"
    end
    return false, "Unknown moderation action"
end

local function apexStopMessaging()
    apexMessagingRunning = false
    local oldSession = apexMessagingSession
    apexMessagingSession = nil
    if oldSession then
        task.spawn(function()
            apexApiRequest("POST", "/disconnect", {}, oldSession.token)
        end)
    end
end

