        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new(fillScale, -7, 0.5, -7)
        knob.BackgroundColor3 = theme.text
        knob.ZIndex = 15
        knob.Parent = sliderBg
        addCorner(knob, 7)

        local dragging = false
        local function updateValue(input)
            local relX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * relX + 0.5)
            valueLabel.Text = fmt(val)
            sliderFill.Size = UDim2.new(relX, 0, 1, 0)
            knob.Position = UDim2.new(relX, -7, 0.5, -7)
            if callback then callback(val) end
        end

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                isDraggingSlider = true
                local p = parent
                while p do
                    if p:IsA("ScrollingFrame") then p.ScrollingEnabled = false end
                    if p == Main then break end
                    p = p.Parent
                end
                updateValue(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateValue(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                isDraggingSlider = false
                local p = parent
                while p do
                    if p:IsA("ScrollingFrame") then p.ScrollingEnabled = true end
                    if p == Main then break end
                    p = p.Parent
                end
            end
        end)
    end

    function safeTeleport(cframe, firePrompt, targetObject)
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local oldAnchored = hrp.Anchored
            hrp.Anchored = false
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            char:PivotTo(cframe)
            RunService.Heartbeat:Wait()
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            if oldAnchored then hrp.Anchored = true end
            workspace.CurrentCamera.CFrame = cframe * CFrame.new(0, 5, 10)
            GuiService.SelectedObject = nil
            
            if firePrompt then
                task.wait(0.2)
                if targetObject then
                    local targetPrompt = targetObject:IsA("ProximityPrompt") and targetObject or targetObject:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if targetPrompt then
                        if fireproximityprompt then
                            pcall(fireproximityprompt, targetPrompt)
                        else
                            pcall(function()
                                targetPrompt:InputHoldBegin()
                                task.wait(targetPrompt.HoldDuration + 0.1)
                                targetPrompt:InputHoldEnd()
                            end)
                        end
                    end
                else
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            local dist = (obj.Parent.Position - hrp.Position).Magnitude
                            if dist < 15 then
                                if fireproximityprompt then
                                    pcall(fireproximityprompt, obj)
                                else
                                    pcall(function()
                                        obj:InputHoldBegin()
                                        task.wait(0.1)
                                        obj:InputHoldEnd()
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
