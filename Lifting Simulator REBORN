local liftThread, sellThread, killThread, buyThread

local function startLift()
    if liftThread then task.cancel(liftThread) end
    liftThread = task.spawn(function()
        while ScreenGui.Parent do
            if isAutoLift() then
                statusLabel.Text = " Status: Auto Lifting..."
                pcall(function() liftingRemote:FireServer() end)
                task.wait(0.1)
            else
                task.wait(0.1)
            end
        end
    end)
end

local function startSell()
    if sellThread then task.cancel(sellThread) end
    sellThread = task.spawn(function()
        while ScreenGui.Parent do
            if isAutoSell() then
                statusLabel.Text = " Status: Auto Selling..."
                pcall(function() sellRemote:InvokeServer() end)
                task.wait(0.5)
            else
                task.wait(0.1)
            end
        end
    end)
end

local function startKill()
    if killThread then task.cancel(killThread) end
    killThread = task.spawn(function()
        while ScreenGui.Parent do
            if isAutoKill() then
                statusLabel.Text = " Status: Finding Demon..."
                local target = nil
                local myChar = player.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if myRoot then
                    local myPos = myRoot.Position
                    local dist = math.huge
                    
                    for _, obj in ipairs(npcFolder:GetChildren()) do
                        if obj:IsA("Model") and obj.Name:lower():find("demon") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                            if root then
                                local d = (root.Position - myPos).Magnitude
                                if d < dist then
                                    dist = d
                                    target = obj
                                end
                            end
                        end
                    end
                end
                
                if target then
                    statusLabel.Text = " Status: Killing " .. target.Name
                    local root = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                    
                    if root and myChar and myRoot then
                        for _, part in ipairs(myChar:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                        
                        myRoot.Anchored = true
                        myRoot.CFrame = root.CFrame
                        task.wait(0.1)
                        
                        for i = 1, 5 do
                            pcall(function() punchRemote:FireServer() end)
                            task.wait(0.1)
                        end
                        
                        myRoot.Anchored = false
                    end
                else
                    statusLabel.Text = " Status: No Demons Found"
                end
                task.wait(0.1)
            else
                task.wait(0.1)
            end
        end
    end)
end

local function startBuy()
    if buyThread then task.cancel(buyThread) end
    buyThread = task.spawn(function()
        while ScreenGui.Parent do
            if isAutoBuy() then
                statusLabel.Text = " Status: Buying & Equipping Best..."
                buyAndEquipBest()
                task.wait(3)
            else
                task.wait(0.1)
            end
        end
    end)
end

