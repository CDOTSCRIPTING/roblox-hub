local function parseCashString(str)
    str = str:gsub(",", ""):gsub("Sxd", "")
    str = str:gsub("%.", "")
    local num = tonumber(str:match("^%d+"))
    if not num then return 0 end
    return num
end

local function getCurrentCash()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return 0 end
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text:find("Sxd") then
            return parseCashString(obj.Text)
        end
    end
    return 0
end

local lastEquippedItemName = ""

local function buyAndEquipBest()
    local cash = getCurrentCash()
    if cash <= 0 then return end
    
    local bestIndex = 1
    local bestItem = weightTable[1]
    for i, item in ipairs(weightTable) do
        if cash >= item.Price then
            bestIndex = i
            bestItem = item
        end
    end
    
    if bestItem and bestItem.Name ~= lastEquippedItemName then
        print("[APEX] Attempting to buy:", bestItem.Name, "| Price:", bestItem.Price)
        pcall(function()
            buyWeightRemote:InvokeServer(bestIndex, weightTable, "Weights")
            task.wait(1)
            equipRemote:InvokeServer(99, "Weights")
            lastEquippedItemName = bestItem.Name
            print("[APEX] Successfully bought and equipped:", bestItem.Name)
        end)
    end
end

