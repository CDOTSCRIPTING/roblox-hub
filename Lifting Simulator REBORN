local miniDragging = false
local miniDragStart = nil
local miniStartPos = nil
local totalMoved = 0

Core.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        miniDragging = true
        miniDragStart = input.Position
        miniStartPos = MinimizedContainer.Position
        totalMoved = 0
    end
end)

Core.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if miniDragging and miniDragStart then
            local delta = input.Position - miniDragStart
            MinimizedContainer.Position = UDim2.new(miniStartPos.X.Scale, miniStartPos.X.Offset + delta.X, miniStartPos.Y.Scale, miniStartPos.Y.Offset + delta.Y)
            totalMoved = math.abs(delta.X) + math.abs(delta.Y)
        end
    end
end)

Core.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if miniDragging then
            miniDragging = false
            miniDragStart = nil
        end
    end
end)

Core.MouseButton1Click:Connect(function()
    if totalMoved > 5 then return end
    MinimizedContainer.Visible = false
    task.defer(function()
        Main.Visible = true
    end)
end)

