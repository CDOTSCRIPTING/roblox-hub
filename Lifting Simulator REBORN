local function CreateToggle(name, yPos)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 34)
    container.Position = UDim2.new(0, 0, 0, yPos)
    container.BackgroundColor3 = theme.surface
    container.BorderSizePixel = 0
    container.ZIndex = 12
    container.Parent = Content
    addCorner(container, 4)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = theme.text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 13
    label.Parent = container
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 44, 0, 22)
    btn.Position = UDim2.new(1, -56, 0, 6)
    btn.BackgroundColor3 = theme.surfaceLight
    btn.BorderSizePixel = 0
    btn.Text = "OFF"
    btn.TextColor3 = theme.subtext
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.AutoButtonColor = false
    btn.ZIndex = 13
    btn.Parent = container
    addCorner(btn, 4)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and theme.accent or theme.surfaceLight
        btn.TextColor3 = state and theme.text or theme.subtext
    end)
    
    return function() return state end
end

