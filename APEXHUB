local function serializeArg(v)
    local t = typeof(v)
    if t == "string" then
        return string.format("%q", v)
    elseif t == "number" or t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Instance" then
        return string.format("game:GetService(\"%s\"):FindFirstChild(\"%s\", true)", v.Parent and v.Parent.Name or "Workspace", v.Name)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%f, %f, %f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local c = v:GetComponents()
        return string.format("CFrame.new(%f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f)", c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
    elseif t == "Color3" then
        return string.format("Color3.new(%f, %f, %f)", v.R, v.G, v.B)
    else
        return "nil --[[ unsupported: " .. t .. " ]]"
    end
end

local function generateScript(remote, method, args)
    local script = ""
    script = script .. "local remote = game:GetService(\"" .. remote.Parent.Name .. "\")"
    local parentPath = remote.Parent:GetFullName():gsub("^game:GetService%(\"[^\"]+\"%)", "")
    if parentPath and parentPath ~= "" then
        for part in parentPath:gmatch("[^%.]+") do
            if part ~= "" then
                script = script .. ":WaitForChild(\"" .. part .. "\")"
            end
        end
    end
    script = script .. ":WaitForChild(\"" .. remote.Name .. "\")\n\n"
    
    local argStrs = {}
    for i, v in ipairs(args) do
        argStrs[#argStrs+1] = serializeArg(v)
    end
    
    if method == "FireServer" then
        if #argStrs > 0 then
            script = script .. "remote:FireServer(" .. table.concat(argStrs, ", ") .. ")"
        else
            script = script .. "remote:FireServer()"
        end
    elseif method == "InvokeServer" then
        if #argStrs > 0 then
            script = script .. "local result = remote:InvokeServer(" .. table.concat(argStrs, ", ") .. ")"
        else
            script = script .. "local result = remote:InvokeServer()"
        end
    end
    return script
end

local function formatArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        local t = type(v)
        if t == "string" then
            table.insert(parts, string.format("%q", v))
        elseif t == "Instance" then
            table.insert(parts, v:GetFullName())
        elseif t == "table" or t == "userdata" then
            table.insert(parts, "{...}")
        else
            table.insert(parts, tostring(v))
        end
    end
    local str = table.concat(parts, ", ")
    if #str > 40 then return string.sub(str, 1, 40) .. "..." end
    return str
end

